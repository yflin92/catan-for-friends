    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@hexlands/server": "workspace:*",
    "@playwright/test": "^1.64.0",
    "@types/jsdom": "^30.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "jsdom": "^26",
    "lighthouse": "^13.5.0",
    "vite": "^7.1.0"
