# deploy/.env template. Copy to deploy/.env on the host (never commit it) and fill in every placeholder.
# Q2 (host), Q13 (region) and Q14 (domain) are open user decisions: see deploy/README.md.

# prod | loadtest. Becomes deployment.environment, the `cluster` label and the env tag.
HEXLANDS_ENV=prod
# The public TLS hostname Caddy serves and certifies (Q14): a custom domain or a free DNS name pointing at the VM.
# Never a bare IP. For a local stack without TLS use http://localhost.
HEXLANDS_SITE_ADDRESS=<Q14: hostname, e.g. play.example.org>

# Room-creation gate (D13/Q9). REQUIRED DECISION for a public host: either set a passphrase here, or set
# HEXLANDS_ALLOW_OPEN_CREATION=yes to accept open creation (the cap and rate limits still apply). deploy.sh refuses
# a prod deploy until one of the two is set.
HEXLANDS_ROOMS_CREATE_PASSPHRASE=
HEXLANDS_ALLOW_OPEN_CREATION=

# Grafana Cloud (free tier) endpoints and the access-policy token Alloy uses. The token is a secret.
GRAFANA_MIMIR_URL=<https://prometheus-…grafana.net/api/prom/push>
GRAFANA_MIMIR_USER=<metrics instance id>
GRAFANA_LOKI_URL=<https://logs-…grafana.net/loki/api/v1/push>
GRAFANA_LOKI_USER=<logs instance id>
GRAFANA_TEMPO_ENDPOINT=<tempo-…grafana.net:443>
GRAFANA_TEMPO_USER=<traces instance id>
GRAFANA_CLOUD_TOKEN=<secret>
# deploy.sh refuses a prod deploy while any value above is unset, unless this is set to yes (no alerts, no dashboards).
# Running without Grafana: set this to yes and BLANK every GRAFANA_* and SM_* line in this file. deploy.sh refuses a
# value still holding its <placeholder>, because Alloy cannot start with one.
HEXLANDS_DEPLOY_ALLOW_NO_OBSERVABILITY=

# Telemetry on or off (design D32b). Off (both lines commented out, the default): no Alloy runs, and the server writes
# its JSON log lines only to stdout (docker logs). On (needed once the Grafana Cloud values above are filled in): set
# both lines. deploy.sh refuses one without the other.
#COMPOSE_PROFILES=telemetry
#HEXLANDS_TELEMETRY=otlp

# Observability as code (deploy/observability/sync.ts, run by deploy.sh): the Grafana stack URL and a service-account
# token (Editor) that may write alert rules, contact points, policies, dashboards and annotations. The token is a secret.
GRAFANA_URL=<https://<stack>.grafana.net>
GRAFANA_SA_TOKEN=<secret>
# Where alerts go (Q11). Empty = a placeholder contact point that delivers nowhere. Examples:
#   {"type":"email","settings":{"addresses":"you@example.org"}}
#   {"type":"discord","settings":{"url":"<webhook url>"}}
GRAFANA_CONTACT_POINT=
# Synthetic Monitoring (/healthz probe every 120 s): the SM API URL and an SM access token from the stack's Synthetic
# Monitoring config page, and the probe ids to run from (comma-separated, near the players).
SM_API_URL=<https://synthetic-monitoring-api-….grafana.net>
SM_ACCESS_TOKEN=<secret>
SM_PROBE_IDS=<e.g. 1,2>
# Game-night windows (ops.gameNightWindows): the server config and the alert time interval share this value.
HEXLANDS_OPS_GAME_NIGHT_WINDOWS=[]

# Nightly backup target for deploy/backup.sh: an rclone remote:path (Backblaze B2 or Cloudflare R2 free tier).
# The rclone remote's credentials live in the host's rclone config, not here. Empty = keep local copies only.
HEXLANDS_BACKUP_REMOTE=
